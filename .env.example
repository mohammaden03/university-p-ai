# Application Environment
APP_ENV=development
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# Recognition Engine Configuration
# Available options: torch_crnn, kraken, demo
MODEL_ENGINE=torch_crnn
DEFAULT_MODEL_ID=persian-arabic-crnn-v1

# Storage Paths (relative to workspace or absolute)
MODEL_DIR=./storage/models
CHECKPOINT_DIR=./storage/checkpoints
DATASET_ROOT=./storage/datasets
TEMP_DIR=/tmp/htr_service

# Resource Limits & Security
MAX_UPLOAD_SIZE=26214400 # 25 MB in bytes
MAX_IMAGE_PIXELS=100000000 # 100 Megapixels
REQUEST_TIMEOUT_SECONDS=60
MAX_CONCURRENT_INFERENCES=4

# Hardware & Acceleration
# cpu or cuda (if CUDA-compatible hardware and PyTorch CUDA are present)
INFERENCE_DEVICE=cpu

# CORS & Security
ALLOWED_ORIGINS=*
INTERNAL_SERVICE_SECRET=dev-secret-persian-htr-key
